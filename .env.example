# ============================================================
# JOBPILOT — CREDENTIALS TEMPLATE
# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored and never uploaded.
# ============================================================

# ── Supabase (your database) ─────────────────────────
# From: supabase.com -> your project -> Settings -> API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── AI models ─────────────────────────────────────────
# Gemini (free): aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY_2=optional_second_gemini_key

# Groq (free backup brain): console.groq.com -> API Keys
GROQ_API_KEY=your_groq_key

# ── Job portals ───────────────────────────────────────
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your_naukri_password
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── Gmail (reports + outreach) ────────────────────────
# App password, NOT your normal password:
# myaccount.google.com/security -> App passwords
GMAIL_EMAIL=you@example.com
GMAIL_APP_PASSWORD=your_16_char_app_password
